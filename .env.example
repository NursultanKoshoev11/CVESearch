# Copy to .env and replace every CHANGE_ME value before starting.

# Runtime
APP_ENV=development
API_LISTEN_ADDR=:8080
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
WEB_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
AUDIT_IP_HASH_KEY=CHANGE_ME_RANDOM_32_BYTE_OR_LONGER_VALUE

# PostgreSQL
POSTGRES_DB=cve_atlas
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD
POSTGRES_APP_USER=cve_atlas_app
POSTGRES_APP_PASSWORD=CHANGE_ME_POSTGRES_APP_PASSWORD
DATABASE_URL=postgres://cve_atlas_app:CHANGE_ME_POSTGRES_APP_PASSWORD@postgres:5432/cve_atlas?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES_SUPERUSER_PASSWORD@postgres:5432/cve_atlas?sslmode=disable

# Tenant bootstrap
BOOTSTRAP_TENANT_ID=00000000-0000-4000-8000-000000000001
BOOTSTRAP_TENANT_SLUG=local
BOOTSTRAP_TENANT_NAME=CVE Atlas Local

# Redis
REDIS_URL=redis://redis:6379/0
SESSION_TTL=1h
LOGIN_FLOW_TTL=10m
SESSION_COOKIE_NAME=cve_atlas_session
SESSION_COOKIE_SECURE=false

# Neo4j
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

# MinIO / S3-compatible object storage
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_BUCKET=cve-atlas
S3_USE_SSL=false

# OIDC (local Keycloak defaults; use an external provider in production)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
OIDC_ISSUER_URL=http://keycloak.localhost:8081/realms/cve-atlas
OIDC_BROWSER_AUTH_URL=
OIDC_BROWSER_LOGOUT_URL=
OIDC_CLIENT_ID=cve-atlas-web
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
OIDC_DEFAULT_ROLE=public_user
OIDC_ROLE_GROUP_MAPPINGS={"/super-administrators":"super_administrator","/platform-analysts":"platform_analyst","/auditors":"auditor"}
KEYCLOAK_TEST_USER=analyst
KEYCLOAK_TEST_PASSWORD=CHANGE_ME_KEYCLOAK_TEST_PASSWORD
KEYCLOAK_TEST_EMAIL=analyst@cve-atlas.local

# OpenTelemetry
OTEL_SERVICE_NAME=cve-atlas-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLE_RATIO=1.0

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
